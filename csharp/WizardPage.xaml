<Page
    x:Class="CampusAuthGuardian.WizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤指示 -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">
            <TextBlock Text="首次使用向导" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="StepTitle" Text="第 1 步，共 4 步" Opacity="0.6" FontSize="14"/>
        </StackPanel>

        <ProgressBar x:Name="StepProgress" Grid.Row="1" Maximum="4" Value="1" Margin="0,0,0,28"/>

        <!-- 步骤容器 -->
        <Grid Grid.Row="2">
            <!-- 第1步：服务器 -->
            <StackPanel x:Name="Step1" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="认证服务器" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="输入学校的认证服务器地址（通常以 /eportal/portal/login 结尾）。不确定可先使用默认值。" TextWrapping="Wrap" Opacity="0.75"/>
                <TextBox x:Name="WizAuthUrl" Header="认证服务器地址"
                         PlaceholderText="http://10.10.102.50:801/eportal/portal/login"
                         Text="http://10.10.102.50:801/eportal/portal/login"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button x:Name="WizTestBtn" Content="检测服务器" Click="WizTest_Click" Padding="20,8"/>
                    <ProgressRing x:Name="WizTestRing" IsActive="False" Width="28" Height="28"/>
                    <FontIcon x:Name="WizTestIcon" Glyph="" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WizTestText" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>

            <!-- 第2步：账号 -->
            <StackPanel x:Name="Step2" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="账号信息" FontSize="18" FontWeight="SemiBold"/>
                <TextBox x:Name="WizStudentId" Header="学号" PlaceholderText="24028116"/>
                <PasswordBox x:Name="WizPassword" Header="密码"/>
                <TextBlock Text="运营商" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <ComboBox x:Name="WizOperator" SelectedIndex="0" MinWidth="240">
                    <ComboBoxItem Content="校园网" Tag="campus"/>
                    <ComboBoxItem Content="中国移动" Tag="cmcc"/>
                    <ComboBoxItem Content="中国联通" Tag="unicom"/>
                    <ComboBoxItem Content="中国电信" Tag="telecom"/>
                </ComboBox>
                <TextBlock Text="密码仅保存在本机 config.ini 中。" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <!-- 第3步：验证 -->
            <StackPanel x:Name="Step3" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="验证配置" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="将使用以上配置尝试一次真实认证（若本机已在线会提示）。" TextWrapping="Wrap" Opacity="0.75"/>
                <Button x:Name="WizAuthBtn" Content="开始验证认证" Click="WizAuth_Click" Style="{ThemeResource AccentButtonStyle}" Padding="20,8"/>
                <ProgressRing x:Name="WizAuthRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock x:Name="WizAuthResult" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </Border>
            </StackPanel>

            <!-- 第4步：完成 -->
            <StackPanel x:Name="Step4" Spacing="12" MaxWidth="560" HorizontalAlignment="Left" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                <TextBlock Text="配置完成" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="建议开启守护模式：断网后自动重连认证。" TextWrapping="Wrap" Opacity="0.75"/>
                <ToggleSwitch x:Name="WizGuardian" OnContent="开启守护模式" OffContent="暂不开启" Toggled="WizGuardian_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- 导航按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button x:Name="BackBtn" Content="上一步" Click="Back_Click" Padding="20,8" IsEnabled="False"/>
            <Button x:Name="NextBtn" Content="下一步" Click="Next_Click" Style="{ThemeResource AccentButtonStyle}" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Page>
