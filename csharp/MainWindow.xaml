<Window
    x:Class="CampusAuthGuardian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="校园网认证守护 CampusAuthGuardian">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏拖拽区 -->
        <Grid x:Name="AppTitleBar" Height="36" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE701;" FontSize="14"/>
                <TextBlock Text="校园网认证守护" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="状态" Tag="status">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- 状态页 -->
                <ScrollViewer x:Name="StatusPage" Padding="28,20" Visibility="Visible">
                    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="网络状态" FontSize="26" FontWeight="SemiBold"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Internet 连通性卡 -->
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="18"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse x:Name="NetLight" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Text="Internet 连通性" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NetStatusText" Text="等待检测…" FontSize="17"/>
                                    <TextBlock x:Name="NetDetailText" Text="检测目标：config.ini 中的 check_url" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Portal 认证卡 -->
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="18"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse x:Name="AuthLight" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Text="Portal 认证" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AuthStatusText" Text="未知" FontSize="17"/>
                                    <TextBlock x:Name="AuthDetailText" Text="ePortal 会话状态" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 详情行（守护/最近事件） -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Ellipse x:Name="StatusLight" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="检测中…" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <FontIcon x:Name="StatusIcon" Glyph="&#xE770;" FontSize="20" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailText" Text="守护模式未启动" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="AuthNowBtn" Click="AuthNow_Click" Style="{ThemeResource AccentButtonStyle}" Padding="24,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="立即认证"/>
                                </StackPanel>
                            </Button>
                            <ToggleSwitch x:Name="GuardianToggle" OffContent="守护模式" OnContent="守护模式" Toggled="Guardian_Toggled"/>
                            <Button Click="OpenLoginPage_Click" Padding="20,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14"/>
                                    <TextBlock Text="打开登录页"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Logout_Click" Padding="20,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF3B1;" FontSize="14"/>
                                    <TextBlock Text="注销登录"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="运营商" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ComboBox x:Name="OperatorBox" SelectedIndex="0" MinWidth="240" SelectionChanged="Operator_SelectionChanged">
                            <ComboBoxItem Content="校园网" Tag="campus"/>
                            <ComboBoxItem Content="中国移动" Tag="cmcc"/>
                            <ComboBoxItem Content="中国联通" Tag="unicom"/>
                            <ComboBoxItem Content="中国电信" Tag="telecom"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- 设置页 -->
                <ScrollViewer x:Name="SettingsPage" Padding="28,20" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>

                        <InfoBar x:Name="InfoBar" IsOpen="False" Severity="Success" CloseButtonClick="InfoBar_Close"/>

                        <TextBlock Text="服务器" Opacity="0.6" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBox x:Name="AuthUrlBox" Header="认证服务器地址" PlaceholderText="http://10.10.102.50:801/eportal/portal/login"/>
                        <TextBox x:Name="CheckUrlBox" Header="连通性检测地址" PlaceholderText="http://www.baidu.com"/>

                        <TextBlock Text="账号" Opacity="0.6" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StudentIdBox" Grid.Column="0" Header="学号"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Header="密码"/>
                        </Grid>
                        <TextBox x:Name="FixedIpBox" Header="固定 IP（留空自动检测）" PlaceholderText="10.59.29.29"/>

                        <TextBlock Text="守护策略" Opacity="0.6" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="CheckIntervalBox" Grid.Column="0" Header="检测间隔（秒）" Minimum="5" Maximum="3600" Value="30"/>
                            <NumberBox x:Name="RetryIntervalBox" Grid.Column="1" Header="重试间隔（秒）" Minimum="1" Maximum="3600" Value="10"/>
                            <NumberBox x:Name="MaxRetriesBox" Grid.Column="2" Header="最大重试" Minimum="1" Maximum="100" Value="3"/>
                        </Grid>

                        <ToggleSwitch x:Name="AutostartToggle" OffContent="开机自启" OnContent="开机自启" Toggled="Autostart_Toggled" Margin="0,6,0,0"/>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                            <Button Click="Save_Click" Style="{ThemeResource AccentButtonStyle}" Padding="24,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                    <TextBlock Text="保存设置"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OpenConfig_Click" Padding="20,8" Content="打开配置文件"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 日志页 -->
                <Grid x:Name="LogsPage" Padding="28,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="运行日志" FontSize="26" FontWeight="SemiBold"/>
                        <Button Click="RefreshLogs_Click" VerticalAlignment="Center" Content="刷新"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="LogsScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogsText" FontFamily="Consolas" FontSize="12.5"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" Padding="14" LineHeight="20"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </NavigationView>

        <!-- 首次使用向导：覆盖式 -->
        <Frame x:Name="WizardFrame" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
    </Grid>
</Window>
